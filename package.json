{
    "name": "localpdf",
    "version": "1.0.0",
    "private": true,
    "description": "Herramientas PDF 100 % en el navegador: los archivos nunca salen del equipo.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ramon3198/localpdf.git"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "build:static": "next build",
        "start": "next start -H 127.0.0.1",
        "test:engine": "node scripts/engine-selftest.mjs",
        "engine:build": "tsc src/lib/pdf-text-engine/index.ts --outDir node_modules/.cache/pte --module commonjs --target es2020 --esModuleInterop --skipLibCheck --strict --downlevelIteration --moduleResolution node"
    },
    "dependencies": {
        "@cantoo/pdf-lib": "^2.6.5",
        "@pdf-lib/fontkit": "^1.1.1",
        "@pdf-lib/standard-fonts": "^1.0.0",
        "@tailwindcss/postcss": "^4.2.2",
        "@untitledui/icons": "^0.0.22",
        "docx": "^9.7.2",
        "jszip": "^3.10.1",
        "motion": "^12.38.0",
        "next": "16.3.6",
        "next-themes": "^0.4.6",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^5.7.284",
        "react": "^19.2.4",
        "react-aria": "^3.47.0",
        "react-aria-components": "^1.16.0",
        "react-dom": "^19.2.4",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.2",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.0.1",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^25.5.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "postcss": "^8.5.28",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "typescript": "^5.9.3"
    }
}
